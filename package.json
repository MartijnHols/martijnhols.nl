{
  "name": "martijnhols.nl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm start",
    "build": "next build",
    "start": "next dev",
    "lint": "pnpm --silent lint:code && pnpm --silent lint:rest",
    "lint:code": "pnpm --silent lint:code:specific '**/*.{js,jsx,ts,tsx}'",
    "lint:code:specific": "CODE_STYLE=true eslint --format stylish --max-warnings 0",
    "lint:code:specific:fix": "pnpm lint:code:specific --fix",
    "lint:rest": "pnpm --silent lint:rest:specific '**/*.{json,md,css,graphql,yml,yaml}'",
    "lint:rest:specific": "prettier --check",
    "lint:rest:specific:fix": "prettier --write",
    "lint:fix": "pnpm --silent lint:code --fix && prettier --write '**/*.{json,md,css,graphql,yml,yaml}'",
    "fix-all": "pnpm install && pnpm lint:fix && pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@floating-ui/react": "^0.27.20",
    "@lhci/cli": "^0.14.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/material-nextjs": "^6.5.0",
    "@next/mdx": "^15.5.25",
    "concurrently": "^8.2.2",
    "next": "^15.5.25",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-transition-group": "^4.4.5",
    "remark-gfm": "^4.0.1",
    "rss": "^1.2.2",
    "sanitize.css": "^13.0.0",
    "satori": "^0.10.14",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^15.5.25",
    "@next/eslint-plugin-next": "^15.5.25",
    "@svgr/webpack": "^8.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-transition-group": "^4.4.12",
    "@types/rss": "^0.0.32",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^8.0.3",
    "lint-staged": "^12.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "!(*\\.generated)\\.{ts,tsx,js,jsx}": [
      "pnpm --silent lint:code:specific:fix"
    ],
    "*.{json,md,css,scss,graphql,yml,yaml}": [
      "pnpm --silent lint:rest:specific:fix"
    ]
  }
}
